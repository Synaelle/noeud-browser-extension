{
  "name": "noeud-extension",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "version": "0.2.1",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build --mode chromium && vite build --mode firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "lint": "eslint . && prettier --check . && pnpm check && web-ext lint --source-dir dist/firefox --self-hosted",
    "format": "prettier --write .",
    "test": "vitest run",
    "package": "web-ext build --source-dir dist/firefox --artifacts-dir dist/packages --overwrite-dest"
  },
  "dependencies": {
    "lucide-static": "1.61.0",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "playwright-core": "1.65.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "web-ext": "10.8.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-svelte"
    ],
    "overrides": [
      {
        "files": "*.svelte",
        "options": {
          "parser": "svelte"
        }
      }
    ]
  }
}
